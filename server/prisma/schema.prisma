generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Int // in KES
  category    String
  description String
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([createdAt])
  @@index([price])
}
